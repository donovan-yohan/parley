{
  "name": "parley-last-lantern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "smoke:runtime": "node scripts/smoke-parley-runtime.mjs",
    "smoke:e2e": "node scripts/smoke-parley-e2e.mjs",
    "smoke:scenarios": "node scripts/smoke-parley-scenarios.mjs",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --import tsx --test test/contracts/*.test.ts",
    "instance:materialize": "node scripts/parley-instance-materialize.mjs",
    "migrate:scenario": "node scripts/parley-migrate-scenario.mjs",
    "validate:pr10": "node --import tsx scripts/validate-pr10-artifacts.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  }
}
