  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "preact": "^10.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^20.19.39",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  }
